# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_EXPIRE_MINUTES=30

# Mailtrap sandbox (Email Testing > Inboxes > your inbox > SMTP credentials).
# Leave SMTP_USERNAME empty to print emails to the console instead.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Dzidzo <no-reply@dzidzo.local>
