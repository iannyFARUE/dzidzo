# PostgreSQL connection. Percent-encode special characters in the password ("@" -> "%40").
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dzidzodb

# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFY_EXPIRE_MINUTES=1440

# Mailtrap sandbox (Email Testing > Inboxes > your inbox > SMTP credentials).
# Leave SMTP_USERNAME empty to print emails to the console instead.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Dzidzo <no-reply@dzidzo.local>

# Where uploads (profile photos, covers) go: "local" (MEDIA_ROOT) or "s3".
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
# Leave both empty to use the usual AWS credential chain (~/.aws, env vars, IAM role).
S3_ACCESS_KEY_ID=<your-aws-access-key>
S3_SECRET_ACCESS_KEY=<your-aws-access-key-secret>
# Optional: serve files from a CDN/custom domain instead of the bucket's own URL.
S3_PUBLIC_URL=
